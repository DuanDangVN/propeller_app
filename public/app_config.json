{
  "acquisition": {
    "mode": "hardware",
    "sampling_rate_hz": 1000,
    "block_size": 100,
    "update_interval_ms": 100,
    "force_channel": "ai2",
    "force_negative_input": "ai6",
    "torque_channel": "ai1",
    "torque_negative_input": "ai5",
    "voltage_min_v": 0.0,
    "voltage_max_v": 10.0
  },
  "filter": {
    "mode": "moving_average",
