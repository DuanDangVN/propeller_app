  },
  "display": {
    "show_raw": true,
    "show_filtered": true,
    "max_plot_points": 1000
  },
  "storage": {
    "save_raw": true
  },
  "zero": {
    "duration_s": 1.5
  },
  "rpm": {
    "counter": "ctr0",
    "terminal": "PFI0",
    "pulses_per_revolution": 1,
    "calculation_window_s": 0.1,
    "timeout_s": 1.5
  }
